@page
@model Crayon.Box.Pages.Index

@{
    Layout = "_Layout";
    ViewBag.Title = "";
}

<div class="home-container">
    <!-- Left Sidebar Navigation -->
    <aside class="left-sidebar">
        <div class="sidebar-card glass-card">
            <nav class="sidebar-nav">
                <a href="#" class="sidebar-link active">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    <span>Home</span>
                </a>
                <a href="#" class="sidebar-link">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <span>Search</span>
                </a>
                <a href="#" class="sidebar-link">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                        <polyline points="17 6 23 6 23 12"/>
                    </svg>
                    <span>Trending</span>
                </a>
                <a href="#" class="sidebar-link">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    <span>Messages</span>
                </a>
            </nav>
        </div>
    </aside>

    <!-- Center Feed -->
    <main class="main-feed">
        <!-- User Info Card -->
        <div class="user-info-card glass-card">
            <div class="user-header">
                <div class="user-avatar">JD</div>
                <div class="user-details">
                    <h2 class="user-name">John Doe</h2>
                    <p class="user-username">@@johndoe</p>
                </div>
            </div>
            <div class="user-stats">
                <div class="stat-item">
                    <span class="stat-value">247</span>
                    <span class="stat-label">Friends</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">1.2k</span>
                    <span class="stat-label">Posts</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">3.4k</span>
                    <span class="stat-label">Likes</span>
                </div>
            </div>
        </div>

        <!-- Feed -->
        <div class="feed-section">
            <h3 class="feed-title">For You</h3>

            <!-- Photo Post -->
            <div class="post-card glass-card">
                <div class="post-header">
                    <div class="post-avatar">SM</div>
                    <div class="post-author">
                        <h4 class="post-author-name">Sarah Miller</h4>
                        <p class="post-time">2 hours ago</p>
                    </div>
                </div>
                <p class="post-content">Check out this amazing sunset I captured! 📸✨</p>
                <div class="post-media">
                    <div class="post-photo-placeholder">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                        <p>Sunset Photo</p>
                    </div>
                </div>
                <div class="post-actions">
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                        <span>89</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <span>12</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                            <polyline points="16 6 12 2 8 6"/>
                            <line x1="12" y1="2" x2="12" y2="15"/>
                        </svg>
                        <span>Share</span>
                    </button>
                </div>
            </div>

            <!-- Video Post -->
            <div class="post-card glass-card">
                <div class="post-header">
                    <div class="post-avatar">MJ</div>
                    <div class="post-author">
                        <h4 class="post-author-name">Mike Johnson</h4>
                        <p class="post-time">5 hours ago</p>
                    </div>
                </div>
                <p class="post-content">My skateboarding progression over the past year! 🛹🔥</p>
                <div class="post-media">
                    <div class="post-video-placeholder">
                        <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="12" cy="12" r="10"/>
                            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/>
                        </svg>
                        <p>Skateboarding Video</p>
                        <span class="video-duration">2:34</span>
                    </div>
                </div>
                <div class="post-actions">
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                        <span>143</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <span>28</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                            <polyline points="16 6 12 2 8 6"/>
                            <line x1="12" y1="2" x2="12" y2="15"/>
                        </svg>
                        <span>Share</span>
                    </button>
                </div>
            </div>

            <!-- Tweet/Text Only Post -->
            <div class="post-card glass-card">
                <div class="post-header">
                    <div class="post-avatar">EC</div>
                    <div class="post-author">
                        <h4 class="post-author-name">Emily Chen</h4>
                        <p class="post-time">8 hours ago</p>
                    </div>
                </div>
                <p class="post-content">Just finished reading "The Design of Everyday Things" - highly recommend it to anyone in tech! The way Don Norman explains user-centered design is timeless. 📚✨</p>
                <div class="post-actions">
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                        <span>67</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <span>15</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                            <polyline points="16 6 12 2 8 6"/>
                            <line x1="12" y1="2" x2="12" y2="15"/>
                        </svg>
                        <span>Share</span>
                    </button>
                </div>
            </div>

            <!-- Text Post -->
            <div class="post-card glass-card">
                <div class="post-header">
                    <div class="post-avatar">TW</div>
                    <div class="post-author">
                        <h4 class="post-author-name">Tom Wilson</h4>
                        <p class="post-time">1 day ago</p>
                    </div>
                </div>
                <p class="post-content">Excited to announce my new project launch! Thanks everyone for the support 🚀</p>
                <div class="post-actions">
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                        <span>156</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <span>34</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                            <polyline points="16 6 12 2 8 6"/>
                            <line x1="12" y1="2" x2="12" y2="15"/>
                        </svg>
                        <span>Share</span>
                    </button>
                </div>
            </div>

            <!-- Photo Post with Multiple Images -->
            <div class="post-card glass-card">
                <div class="post-header">
                    <div class="post-avatar">RL</div>
                    <div class="post-author">
                        <h4 class="post-author-name">Rachel Lee</h4>
                        <p class="post-time">2 days ago</p>
                    </div>
                </div>
                <p class="post-content">Weekend hiking adventures in the mountains! 🏔️⛰️</p>
                <div class="post-media">
                    <div class="post-photo-grid">
                        <div class="post-photo-placeholder">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                <circle cx="8.5" cy="8.5" r="1.5"/>
                                <polyline points="21 15 16 10 5 21"/>
                            </svg>
                        </div>
                        <div class="post-photo-placeholder">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                <circle cx="8.5" cy="8.5" r="1.5"/>
                                <polyline points="21 15 16 10 5 21"/>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="post-actions">
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                        <span>201</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <span>45</span>
                    </button>
                    <button class="post-action-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                            <polyline points="16 6 12 2 8 6"/>
                            <line x1="12" y1="2" x2="12" y2="15"/>
                        </svg>
                        <span>Share</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Right Sidebar - Messages -->
    <aside class="right-sidebar">
        <div class="messages-section">
            <h3 class="messages-title">Messages</h3>

            <div class="message-item glass-card">
                <div class="message-avatar">AL</div>
                <div class="message-info">
                    <h4 class="message-name">Alice Lee</h4>
                    <p class="message-preview">Hey! Did you see the latest update?</p>
                </div>
                <span class="message-time">2m</span>
            </div>

            <div class="message-item glass-card">
                <div class="message-avatar">DW</div>
                <div class="message-info">
                    <h4 class="message-name">David Williams</h4>
                    <p class="message-preview">Thanks for sharing that article!</p>
                </div>
                <span class="message-time">1h</span>
            </div>

            <div class="message-item glass-card">
                <div class="message-avatar">LB</div>
                <div class="message-info">
                    <h4 class="message-name">Lisa Brown</h4>
                    <p class="message-preview">Let's catch up this weekend</p>
                </div>
                <span class="message-time">3h</span>
            </div>

            <div class="message-item glass-card">
                <div class="message-avatar">RT</div>
                <div class="message-info">
                    <h4 class="message-name">Robert Taylor</h4>
                    <p class="message-preview">Great meeting today!</p>
                </div>
                <span class="message-time">5h</span>
            </div>

            <div class="message-item glass-card">
                <div class="message-avatar">JW</div>
                <div class="message-info">
                    <h4 class="message-name">Jessica White</h4>
                    <p class="message-preview">Can you send me the files?</p>
                </div>
                <span class="message-time">1d</span>
            </div>
        </div>
    </aside>
</div>