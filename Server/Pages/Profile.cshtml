@page "/@{id}"
@using Org.BouncyCastle.Bcpg
@model Crayon.Box.Pages.Profile


@{
    Layout = "_Layout";
    ViewBag.Title = $"{Model.Id} - ";
    ViewBag.Organization = Model.Organization;
    ViewBag.Ver = Model.Ver.ToString();
}

@if (Model.UserExists) {
  @if (Model.ProviderConnected)
  {
      <div class="user-canvas turubai-render-target"></div>
      <script type="module">

        import init, { render_profile } from '/turubai/imports.js';
        await init('/@@@(Model.Id)/theme/binaries.wasm');
        try {
          render_profile();
        } catch (e) {
          console.log(e);
          // Expected: WASM returns control to the browser event loop
          // so spawn_local async tasks can execute and render the UI.
        }
      </script>
  }
  else
  {
      <p class="text-center text-font-fancy">Tragically, @@<span class="bold">@Model.Id</span> is offline!</p>
      <h1 class="text-xxl text-center" style="margin-top: 8rem;">߹𖥦߹</h1>
      <p class="text-center text-font-fancy">Try again at a later time.</p>
  }
} else {
  <p class="text-center text-font-fancy">No User "@@<span class="bold">@Model.Id</span>" could be found!</p>
  <h1 class="text-xxl text-center" style="margin-top: 8rem;">404</h1>
  <p class="text-center text-font-fancy">But hey, looks like this username is available.</p>
}

    

