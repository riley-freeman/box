@{
    var mainNavLinks = new[]
    {
        new { Text = "Home", Link = "/", ImageSource = "/images/house.svg" },
        new { Text = "Search", Link = "/search", ImageSource = "/images/search.svg" },
        new { Text = "Trending", Link = "/trending", ImageSource = "/images/graph-up-arrow.svg" },
        new { Text = "Messages", Link = "/messages", ImageSource = "/images/chat-dots.svg" },
        new { Text = "Upload", Link = "/upload", ImageSource = "/images/box-arrow-in-down.svg" },
        new { Text = "Profile", Link = "/", ImageSource = "/images/person.svg" }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"]The Crayon Box</title>

    <link rel="stylesheet" href="/css/globals.css"/>
    <link rel="stylesheet" href="/css/sections.css"/>
    <link rel="stylesheet" href="/css/search-boxes.css"/>
    <link rel="stylesheet" href="/css/index.css"/>
    <link rel="stylesheet" href="/css/navigation.css"/>
    <link rel="stylesheet" href="/css/paper.css"/>
</head>
<body class="flex-nav-and-body">

<header class="side-header">
    <nav class="side-navibar-main-links">
        <div class="navbar-icon">
            <!-- TODO: Add the actual logo, we are dependant on the Operating System-->
            <h1 class="nav-logo-text">📦</h1>
        </div>

        <div class=".nav-main-element ">
            @foreach (var link in mainNavLinks)
            {
                @await Html.PartialAsync("_NavigationBarIcon", link)
            }
        </div>
    </nav>
    <div class="side-navibar-misc-links">
        <a href="#" class="nav-misc-link"><h3>More</h3></a>
    </div>
</header>
<main class="body-content">
    <div class="printed-paper-effect">
        @RenderBody()
    </div>
</main>
</body>
</html>